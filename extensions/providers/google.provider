<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE provider>
<provider version="1.0" id="google">
    <name>Google</name>
    <description>Google account provider</description>
    <icon>extensions/icons/icon-l-google.png</icon>
    <sign-up-link>www.google.com</sign-up-link>
    <domains>.*google\.com</domains>

    <template>
        <group name="auth">
            <setting name="method">oauth2</setting>
            <setting name="mechanism">user_agent</setting>
            <group name="oauth2">
                <group name="user_agent">
                    <setting name="Host">accounts.google.com</setting>
                    <setting name="AuthPath">o/oauth2/auth</setting>
                    <setting name="TokenPath">o/oauth2/token</setting>
                    <setting name="RedirectUri">urn:ietf:wg:oauth:2.0:oob</setting>
                    <setting name="ResponseType">token</setting>
                    <setting name="Scope" type="as">["https://docs.google.com/feeds/","https://www.googleapis.com/auth/googletalk","https://www.googleapis.com/auth/userinfo.email","https://www.googleapis.com/auth/userinfo.profile","https://picasaweb.google.com/data/"]</setting>
                    <setting name="AllowedSchemes" type="as">["https","http"]</setting>
<!--
                    The following must be provided by the application via:
                        serviceAccount.setConfigurationValue("auth/oauth2/user_agent/ClientId", client_id)
                    <setting name="ClientId">application_client_id</setting>
-->
                </group>
            </group>
        </group>
    </template>    
</provider>
